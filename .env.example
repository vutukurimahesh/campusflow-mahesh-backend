# Copy to .env for local use (never commit .env). On Render, enter these in Environment.
# JDBC URL: jdbc:postgresql://<host>:<port>/<database>
DB_URL=jdbc:postgresql://localhost:5432/campusflow
DB_USERNAME=campusflow
DB_PASSWORD=change-me
# Min 32 characters. Generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-of-32+chars
JWT_EXPIRATION_MINUTES=720
# Exact origin of the deployed frontend (no trailing slash). Comma-separate for several.
FRONTEND_ORIGIN=http://localhost:5173
# Render sets PORT automatically. Only set it locally if 8080 is taken.
PORT=8080
APP_TIMEZONE=Asia/Kolkata
